# Copy to .env. Never commit .env.

# The live patient, the attending's debrief and case drafting. Without it the
# app runs fully offline: canned patient, checklist debrief, no drafting.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (default claude-opus-5).
# On a small budget use Haiku: about a fifth the cost per call, and for a
# patient who answers in two short sentences the difference barely shows.
# The code drops the options Haiku rejects (effort, refusal fallbacks) on its
# own, so this is a one-line change and nothing else needs touching.
# YH_MODEL=claude-haiku-4-5

# Public origin, used for invite links and Stripe redirects.
APP_URL=http://localhost:8000

# Billing (optional). Without these every school is on the free plan.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SEAT=price_...

# Set to 1 behind HTTPS so session cookies are Secure.
# YH_SECURE_COOKIES=1
# Database file (default: data/yahakim.db)
# YH_DB=data/yahakim.db
