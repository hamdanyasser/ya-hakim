# Copy to .env. Never commit .env.

# The live patient, the attending's debrief and case drafting. Without it the
# app runs fully offline: canned patient, checklist debrief, no drafting.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: which Claude models to use. One key works for all of them.
#   YH_PATIENT_MODEL  the patient's replies -- many small calls, so a fast
#                     cheap model is the natural choice
#   YH_MODEL          AI debriefs and case drafting (and the patient if the
#                     line above is not set). Default: claude-opus-5
# On a small budget use Haiku: about a fifth the cost per call. The code drops
# the options Haiku rejects (effort, refusal fallbacks) on its own.
# YH_PATIENT_MODEL=claude-haiku-4-5
# YH_MODEL=claude-haiku-4-5

# Public origin, used for invite links and Stripe redirects.
APP_URL=http://localhost:8000

# Billing (optional). Without these every school is on the free plan.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SEAT=price_...

# Session cookies are Secure automatically when APP_URL starts with https://.
# Override with 1 or 0 only if that guess is wrong for your setup.
# YH_SECURE_COOKIES=1
# Database file (default: data/yahakim.db)
# YH_DB=data/yahakim.db
